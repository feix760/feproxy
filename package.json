{
  "name": "feproxy",
  "version": "3.4.0",
  "description": "An node proxy server for web development",
  "scripts": {
    "start": "cross-env NODE_ENV=production node lib/index.js",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"webpack -w\" \"sleep 3 && nodemon --watch lib --ext js --ignore lib/public/ lib/index.js\"",
    "build": "npm run build:ts && npm run build:web",
    "build:ts": "tsc",
    "build:web": "cross-env NODE_ENV=production webpack",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint-fix": "eslint --cache --fix .",
    "jest": "cross-env NODE_ENV=testing jest",
    "test": "npm run lint && npm run build && npm run jest",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "standard-version",
    "prepare": "npm run build"
  },
  "bin": {
    "feproxy": "bin/feproxy.js"
  },
  "dependencies": {
    "brotli": "^1.3.2",
    "chalk": "^2.3.2",
    "chrome-devtools-frontend": "1.0.661035",
    "cross-env": "^5.2.0",
    "escape-string-regexp": "^2.0.0",
    "fs-extra": "^5.0.0",
    "get-port": "^5.0.0",
    "iconv-lite": "^0.4.19",
    "ip": "^1.1.5",
    "jschardet": "^1.6.0",
    "koa": "^2.5.0",
    "koa-body": "^2.6.0",
    "koa-compose": "^4.1.0",
    "koa-router": "^7.4.0",
    "koa-static": "^5.0.0",
    "lru-cache": "^5.1.1",
    "mime-types": "^2.1.24",
    "mkdirp": "^0.5.1",
    "node-forge": "^0.10.0",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "statuses": "^1.5.0",
    "ws": "^7.0.0",
    "yargs": "^12.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.4.4",
    "@babel/plugin-transform-modules-commonjs": "^7.4.4",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.29.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^5.1.0",
    "@types/ip": "^1.1.3",
    "@types/jest": "^30.0.0",
    "@types/koa": "^2.15.2",
    "@types/koa-compose": "^3.2.9",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/lru-cache": "^5.1.1",
    "@types/mime-types": "^2.1.4",
    "@types/mkdirp": "^0.5.2",
    "@types/node": "^24.13.3",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/request-promise": "^4.1.51",
    "@types/statuses": "^1.5.4",
    "@types/ws": "^7.4.7",
    "@types/yargs": "^12.0.20",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.4",
    "conventional-changelog-cli": "^2.0.21",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "element-theme-default": "^1.4.13",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob-all": "^3.1.0",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.8",
    "isomorphic-fetch": "^2.2.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "less": "^4.8.1",
    "less-loader": "^13.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^1.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "standard-version": "^9.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "files": [
    "bin",
    "lib",
    "doc",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/feix760/feproxy",
  "bugs": {
    "url": "https://github.com/feix760/feproxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feix760/feproxy.git"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/test/__mocks__/styleMock.js",
      "\\.(png|jpg|jpeg|gif|ttf|eot|svg)$": "<rootDir>/test/__mocks__/fileMock.js",
      "^element-theme-default\\.*": "<rootDir>/test/__mocks__/styleMock.js"
    },
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "{src,bin}/**/*.{ts,tsx,js,jsx}",
      "!src/frontend/asset/**",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testRegex": "test/.*\\.test\\.[jt]sx?$",
    "testEnvironment": "node"
  },
  "license": "MIT"
}
