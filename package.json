{
  "name": "feproxy",
  "version": "3.9.0",
  "description": "An node proxy server for web development",
  "scripts": {
    "start": "cross-env NODE_ENV=production node lib/index.js",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"webpack -w\" \"sleep 3 && nodemon --watch lib --ext js --ignore lib/public/ lib/index.js\"",
    "build": "npm run build:ts && npm run build:web",
    "build:ts": "tsc",
    "build:web": "cross-env NODE_ENV=production webpack",
    "build:favicon": "node scripts/buildFavicon.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint-fix": "eslint --cache --fix .",
    "jest": "cross-env NODE_ENV=testing jest",
    "test": "npm run lint && npm run build && npm run jest",
    "release": "standard-version",
    "prepare": "npm run build"
  },
  "bin": {
    "feproxy": "bin/feproxy.js"
  },
  "dependencies": {
    "@chrome-devtools/inspector": "1.20251611.0",
    "@koa/router": "^15.7.0",
    "brotli": "^1.3.2",
    "chalk": "^4.1.2",
    "cross-env": "^10.1.0",
    "escape-string-regexp": "^3.0.0",
    "fs-extra": "^11.4.0",
    "get-port": "^5.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "iconv-lite": "^0.7.3",
    "ip": "^2.0.1",
    "jschardet": "^3.1.4",
    "koa": "^3.2.1",
    "koa-body": "^8.0.0",
    "koa-compose": "^4.1.0",
    "koa-static": "^5.0.0",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.4.0",
    "statuses": "^2.0.2",
    "ws": "^8.21.3",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.4.4",
    "@babel/plugin-transform-modules-commonjs": "^7.4.4",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.29.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/ip": "^1.1.3",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-compose": "^3.2.9",
    "@types/koa-static": "^4.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/statuses": "^2.0.6",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob-all": "^3.1.0",
    "globals": "^17.0.0",
    "html-webpack-plugin": "^5.6.8",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "less": "^4.8.1",
    "less-loader": "^13.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "standard-version": "^9.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "files": [
    "bin",
    "lib",
    "doc",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "homepage": "https://github.com/feix760/feproxy",
  "bugs": {
    "url": "https://github.com/feix760/feproxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feix760/feproxy.git"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/test/__mocks__/styleMock.js",
      "\\.(png|jpg|jpeg|gif|ttf|eot|svg)$": "<rootDir>/test/__mocks__/fileMock.js"
    },
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "{src,bin}/**/*.{ts,tsx,js,jsx}",
      "!src/frontend/asset/**",
      "!src/**/*.d.ts"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "testRegex": "test/.*\\.test\\.[jt]sx?$",
    "testEnvironment": "node",
    "testTimeout": 10000
  },
  "license": "MIT"
}
